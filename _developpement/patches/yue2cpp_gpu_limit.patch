+// Limite d'utilisation du GPU, Studio YuE2 : après chaque pas, pause proportionnelle à sa durée pour que la
+// carte travaille L % du temps. L est relu à chaque pas dans le fichier YUE2_GPU_LIMIT_FILE (écrit par
+// l'application), un changement de réglage s'applique donc au pas suivant. Sans variable : aucune pause.
+static void nar_gpu_limit_pause(double step_ms) {
+    static const char * limit_file = std::getenv("YUE2_GPU_LIMIT_FILE");
+    if (!limit_file) {
+        return;
+    }
+    int L = 100;
+    if (FILE * f = std::fopen(limit_file, "r")) {
+        if (std::fscanf(f, "%d", &L) != 1) {
+            L = 100;
+        }
+        std::fclose(f);
+    }
+    if (L >= 10 && L < 100) {
+        std::this_thread::sleep_for(std::chrono::milliseconds((long long) (step_ms * (100 - L) / L)));
+    }
+}
